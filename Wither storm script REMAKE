-- Phase model IDs
local phaseModels = {
    [1] = "rbxassetid://10973669978",
    [2] = "rbxassetid://10980258642",
    [3] = "rbxassetid://10980269902",
    [4] = "rbxassetid://16333057394", -- fixed Phase 4 model

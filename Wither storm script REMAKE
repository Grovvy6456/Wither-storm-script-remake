local spawnedStorm = nil
local currentColor = nil -- neon color

-- Helpers
local function isCharacterPart(part)
    local model = part:FindFirstAncestorWhichIsA("Model")
    return model and model:FindFirstChildWhichIsA("Humanoid") ~= nil
end

local function disableCollisions(model)
    if not model then return end
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end

-- Color function (neon parts only)
local function colorStorm(storm, color3)
    if not storm then return end
    for _, part in ipairs(storm:GetDescendants()) do
        if part:IsA("BasePart") and (part.Name:lower():find("laser") or part.Name:lower():find("command") or part.Material == Enum.Material.Neon) then
            part.Color = color3
            part.Material = Enum.Material.Neon
            -- Add PointLight
            local light = part:FindFirstChildOfClass("PointLight") or Instance.new("PointLight", part)
            light.Color = color3
            light.Brightness = 5
            light.Range = 15
        end
    end
end

-- Dynamic Phase 7
local function addPhase7()
    if not object then return end
    local phase6Clone = object:Clone()
    phase6Clone.Parent = workspace
    for _, part in ipairs(phase6Clone:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Size = part.Size * 1.2
        end
    end
    local head = phase6Clone:FindFirstChild("Head", true)
    if head and head:IsA("BasePart") then
        head.Size = head.Size * 1.5
        local portal = Instance.new("Part")
        portal.Size = Vector3.new(5, 0.5, 5)
        portal.Anchored = true
        portal.CanCollide = false
        portal.Material = Enum.Material.Neon
        portal.Color = Color3.fromRGB(128, 0, 255)
        portal.CFrame = head.CFrame * CFrame.new(0, head.Size.Y/2 + 0.25, 0)
        portal.Parent = phase6Clone
    end
    phase6Clone.Name = "WitherStormPhase7"
    disableCollisions(phase6Clone)
    if currentColor then
        colorStorm(phase6Clone, currentColor)
    end
    return phase6Clone
end

-- Change phase
local function changePhase(newPhase)
    if currentPhase == newPhase then return end
    if not object then return end

    local ok, oldPosition = pcall(function()
        return object:GetPivot()
    end)
    if not ok or not oldPosition then
        warn("Wither Storm: couldn't get old pivot for phase change.")
        return
    end

    object:Destroy()
    local newObject
    if newPhase == 7 then
        newObject = addPhase7()
    else
        local success
        success, newObject = pcall(function()
            return game:GetObjects(phaseModels[newPhase])[1]
        end)
        if not success or not newObject then
            warn("Wither Storm: failed to load model for phase", newPhase)
            return
        end
        newObject.Parent = workspace
        disableCollisions(newObject)
        if currentColor then
            colorStorm(newObject, currentColor)
        end
    end

    object = newObject
    object:PivotTo(oldPosition)
    currentPhase = newPhase
end

-- Parts destroyed logic
local function onPartDestroyed()
    partsSucked = partsSucked + 1
    for i, threshold in ipairs(phasePartsSucked) do
        if partsSucked >= threshold and currentPhase < i then
            changePhase(i)
            break
        end
    end
end

-- Attraction scanner
coroutine.wrap(function()
    while true do
        task.wait(2)
        if not object or not object.Parent then
            task.wait(1)
            continue
        end

        local candidates = {}
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Parent and not isCharacterPart(obj) and not obj:IsDescendantOf(object) and obj.Size.Magnitude < 20 and not table.find(attractedParts, obj) then
                local ok, objectPos = pcall(function()
                    return object:GetPivot().Position
                end)
                if not ok or not objectPos then break end
                local dist = (obj.Position - objectPos).Magnitude
                table.insert(candidates, {obj = obj, dist = dist})
            end
        end
        if #candidates > 0 then
            table.sort(candidates, function(a, b) return a.dist < b.dist end)
            local chosen = candidates[1].obj
            if chosen and chosen:IsA("BasePart") then
                if chosen.Anchored then
                    chosen.Anchored = false
                end
                table.insert(attractedParts, chosen)
            end
        end
    end
end)()

-- Attraction movement
RunService.Heartbeat:Connect(function(dt)
    if not object or not object.Parent then return end
    for i = #attractedParts, 1, -1 do
        local obj = attractedParts[i]
        if obj and obj.Parent and not isCharacterPart(obj) then
            local ok, objectPos = pcall(function()
                return object:GetPivot().Position
            end)
            if not ok or not objectPos then
                table.remove(attractedParts, i)
                continue
            end

            local dist = (obj.Position - objectPos).Magnitude
            if dist > 2 then
                local lerpAlpha = 0.2 * dt * (100 / math.max(dist, 0.001))
                local newPos = obj.Position:Lerp(objectPos, lerpAlpha)
                obj.CFrame = CFrame.new(newPos) * obj.CFrame.Rotation
            else
                obj:Destroy()
                table.remove(attractedParts, i)
                onPartDestroyed()
            end
        else
            table.remove(attractedParts, i)
        end
    end
end)

-- Phase movement settings
local function getPhaseSettings()
    local phase = currentPhase
    if phase == 1 or phase == 2 or phase == 3 then
        return { minHeight = 5, maxHeight = 30, speed = 1, move = true }
    elseif phase == 4 then
        return { minHeight = 15, maxHeight = 25, speed = 0.7, move = true }
    elseif phase == 5 then
        return { minHeight = 25, maxHeight = 40, speed = 0.3, move = true }
    elseif phase == 6 then
        return { minHeight = 35, maxHeight = 55, speed = 0.2, move = true }
    else
        return { minHeight = 35, maxHeight = 55, speed = 0, move = false } -- phase 7
    end
end

-- Movement coroutine
coroutine.wrap(function()
    while true do
        if not object or not object.Parent then
            task.wait(1)
            continue
        end
        local settings = getPhaseSettings()
        if settings.move then
            local startCFrame = object:GetPivot()
            local playerPivot = character and character:GetPivot() or nil
            if not playerPivot then
                task.wait(1)
                continue
            end

            local randomOffset = Vector3.new(math.random(-50,50), math.random(settings.minHeight, settings.maxHeight), math.random(-50,50))
            local targetPos = playerPivot.Position + randomOffset
            targetPos = Vector3.new(targetPos.X, math.max(targetPos.Y, playerPivot.Position.Y + settings.minHeight), targetPos.Z)
            local dir = targetPos - startCFrame.Position
            if dir.Magnitude < 1 then
                task.wait(1)
                continue
            end
            dir = dir.Unit
            local targetCFrame = CFrame.lookAt(targetPos, targetPos + dir)
            local duration = math.random(math.floor(3 / settings.speed), math.floor(10 / settings.speed))
            local elapsed = 0
            while elapsed < duration do
                elapsed += RunService.Heartbeat:Wait()
                local alpha = elapsed / duration
                if object and object.Parent then
                    object:PivotTo(startCFrame:Lerp(targetCFrame, alpha))
                else break end
            end
        else
            if object and object.Parent then
                local currentCFrame = object:GetPivot()
                local currentPos = currentCFrame.Position
                local playerPivot = character and character:GetPivot() or nil
                if playerPivot then
                    local targetCFrame = CFrame.lookAt(currentPos, playerPivot.Position)
                    object:PivotTo(targetCFrame)
                end
            end
            task.wait(0.1)
        end
    end
end)()

